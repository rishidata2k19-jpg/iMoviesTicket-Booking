# Server Port (Render / Railway / Heroku will set this automatically)
PORT=5000

# MongoDB Connection String
# In production (Render/Railway), use MongoDB Atlas:
# e.g.: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/imovies_db?retryWrites=true&w=majority
# Make sure to allow IP access from anywhere (0.0.0.0/0) in MongoDB Atlas Network Access.
MONGO_URI=mongodb://127.0.0.1:27017/imovies_db

# JWT Secret for authentication tokens
JWT_SECRET=imovies_super_secret_jwt_key_2026

# Environment (development / production)
NODE_ENV=production

# Frontend URL for CORS (e.g., https://your-app.vercel.app or * for all)
CLIENT_URL=*

# TMDB API Key for live market movie synchronization
TMDB_API_KEY=c5cc193b6902f41d06168e18398fba37

